# backend/.env.example
OPENAI_API_KEY=replace-with-a-project-key
OPENAI_MODEL=gpt-4o-mini
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_X_FORWARDED_PROTO=false
JWT_SIGNING_KEY=
JWT_PREVIOUS_SIGNING_KEYS=
JWT_ACCESS_TOKEN_TTL_SECONDS=300
JWT_ISSUER=yeshivish-translator

# Shared cache for rate limits, JWT revocation, and cost guardrails (see
# docs/operations.md). Required for correct behavior with more than one
# worker/instance; falls back to an in-process cache when unset.
REDIS_URL=

# Number of trusted reverse-proxy hops in front of this app. 0 means only
# REMOTE_ADDR is trusted and X-Forwarded-For is ignored.
TRUSTED_PROXY_COUNT=0

# Per-IP, per-session, and global request-rate limits.
THROTTLE_RATE_ANON=60/hour
THROTTLE_RATE_AUTH_SESSION_IP=30/hour
THROTTLE_RATE_AUTH_SESSION_GLOBAL=600/hour
THROTTLE_RATE_TRANSLATE_IP=60/hour
THROTTLE_RATE_TRANSLATE_SESSION=120/hour
THROTTLE_RATE_TRANSLATE_GLOBAL=2000/hour

# OpenAI request resilience.
OPENAI_CONNECT_TIMEOUT_SECONDS=5
OPENAI_READ_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1

# Global cost/usage guardrails (rolling 24h window). Defaults assume
# gpt-4o-mini pricing; adjust if OPENAI_MODEL changes.
OPENAI_INPUT_COST_PER_MILLION_TOKENS=0.15
OPENAI_OUTPUT_COST_PER_MILLION_TOKENS=0.60
DAILY_COST_BUDGET_USD=20
DAILY_REQUEST_BUDGET=5000
